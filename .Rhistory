### White noise process example
# Generate 200 random values from a normal distribution,
# then scale the standard deviation to 5 and shift the mean to 20
epst = rnorm(200) * 5 + 20  # White noise with mean = 20 and sd = 5
# Assign the noise to the time series Xt
Xt = epst  # Xt is now a white noise time series
# Set plotting layout: 2 plots stacked vertically
par(mfrow = c(2, 1))
# Plot the time series: should look random with no visible trend or pattern
plot.ts(Xt, main = "White Noise Time Series")
# Plot the autocorrelation function (ACF)
# For white noise, ACF should be ≈ 0 for all lags except lag 0
acf(Xt, main = "Autocorrelation of White Noise")
XtB=arima.sim(200,model=list(ar=0.8))
plot.ts(XtB)
acf(XtB)
